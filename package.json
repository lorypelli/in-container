{
    "name": "in-container",
    "version": "2.1.5",
    "description": "Check if the current process is running inside a container (Docker, Podman)",
    "keywords": [
        "container",
        "docker",
        "podman",
        "cli"
    ],
    "repository": {
        "url": "https://github.com/lorypelli/in-container"
    },
    "license": "MIT",
    "author": "LoryPelli",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./sync": {
            "import": {
                "types": "./dist/sync.d.mts",
                "default": "./dist/sync.mjs"
            },
            "require": {
                "types": "./dist/sync.d.cts",
                "default": "./dist/sync.cjs"
            }
        },
        "./async": {
            "import": {
                "types": "./dist/async.d.mts",
                "default": "./dist/async.mjs"
            },
            "require": {
                "types": "./dist/async.d.cts",
                "default": "./dist/async.cjs"
            }
        }
    },
    "bin": {
        "in-container": "./dist/cli.mjs"
    },
    "files": [
        "./dist"
    ],
    "scripts": {
        "build": "tsdown",
        "format": "biome check --write",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.4",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=14.18.0"
    }
}
