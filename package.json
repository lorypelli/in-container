{
    "name": "in-container",
    "version": "1.4.0",
    "description": "Check if the current process is running inside a container (Docker, Podman)",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "bin": {
        "in-container": "./dist/cli.mjs"
    },
    "scripts": {
        "build": "tsdown",
        "format": "prettier --write .",
        "prepublishOnly": "pnpm build"
    },
    "files": [
        "./dist/index.mjs",
        "./dist/index.cjs",
        "./dist/index.d.mts",
        "./dist/index.d.cts",
        "./dist/cli.mjs"
    ],
    "keywords": [
        "container",
        "docker",
        "podman",
        "cli"
    ],
    "author": "LoryPelli",
    "license": "MIT",
    "repository": {
        "url": "https://github.com/lorypelli/in-container"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2"
    }
}
