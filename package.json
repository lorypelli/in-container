{
    "name": "in-container",
    "version": "1.2.1",
    "description": "Check if the current process is running inside a container (Docker, Podman)",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "node esbuild.config.js",
        "format": "prettier --write .",
        "prepublishOnly": "pnpm build"
